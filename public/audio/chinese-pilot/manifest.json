    "cn-04-clip-34": {
      "text": "湖光秋月两相和，",
      "pinyin": "hú guāng qiū yuè liǎng xiāng hé",
      "sourceRef": "https://www.scribd.com/document/1067004050/%E4%BA%BA%E6%95%99%E7%89%88-%E4%B8%89%E5%B9%B4%E7%BA%A7%E4%B8%8A%E5%86%8C-2025%E7%A7%8B%E7%89%88-%E8%AF%AD%E6%96%87%E7%94%B5%E5%AD%90%E8%AF%BE%E6%9C%AC 印刷页14",
      "sourceKind": "public_domain_poem",
      "id": "cn-04-clip-34",
      "spokenText": "湖光秋月两相和，",
      "file": "audio/chinese-pilot/927ee8f310f07e35ca9dfb25.mp3",
      "durationSeconds": 2.136,
      "bytes": 34604
    },
    "cn-04-clip-35": {
      "text": "潭面无风镜未磨。",
      "pinyin": "tán miàn wú fēng jìng wèi mó",
      "sourceRef": "https://www.scribd.com/document/1067004050/%E4%BA%BA%E6%95%99%E7%89%88-%E4%B8%89%E5%B9%B4%E7%BA%A7%E4%B8%8A%E5%86%8C-2025%E7%A7%8B%E7%89%88-%E8%AF%AD%E6%96%87%E7%94%B5%E5%AD%90%E8%AF%BE%E6%9C%AC 印刷页14",
      "sourceKind": "public_domain_poem",
      "id": "cn-04-clip-35",
      "spokenText": "潭面无风镜未磨。",
      "file": "audio/chinese-pilot/05c7f0b74f15e25c58fc8511.mp3",
      "durationSeconds": 2.136,
      "bytes": 34604
    },
    "cn-04-clip-36": {
      "text": "遥望洞庭山水翠，",
      "pinyin": "yáo wàng dòng tíng shān shuǐ cuì",
      "sourceRef": "https://www.scribd.com/document/1067004050/%E4%BA%BA%E6%95%99%E7%89%88-%E4%B8%89%E5%B9%B4%E7%BA%A7%E4%B8%8A%E5%86%8C-2025%E7%A7%8B%E7%89%88-%E8%AF%AD%E6%96%87%E7%94%B5%E5%AD%90%E8%AF%BE%E6%9C%AC 印刷页14",
      "sourceKind": "public_domain_poem",
      "id": "cn-04-clip-36",
      "spokenText": "遥望洞庭山水翠，",
      "file": "audio/chinese-pilot/e1a9b8836c3dfbaeacb903d5.mp3",
      "durationSeconds": 2.184,
      "bytes": 35372
    },
    "cn-04-clip-37": {
      "text": "白银盘里一青螺。",
      "pinyin": "bái yín pán lǐ yī qīng luó",
      "sourceRef": "https://www.scribd.com/document/1067004050/%E4%BA%BA%E6%95%99%E7%89%88-%E4%B8%89%E5%B9%B4%E7%BA%A7%E4%B8%8A%E5%86%8C-2025%E7%A7%8B%E7%89%88-%E8%AF%AD%E6%96%87%E7%94%B5%E5%AD%90%E8%AF%BE%E6%9C%AC 印刷页14",
      "sourceKind": "public_domain_poem",
      "id": "cn-04-clip-37",
      "spokenText": "白银盘里一青螺。",
      "file": "audio/chinese-pilot/ad0a3b71e922f9273a371017.mp3",
      "durationSeconds": 1.944,
      "bytes": 31532
    },
    "cn-04-clip-38": {
      "text": "远上寒山石径斜，",
      "pinyin": "yuǎn shàng hán shān shí jìng xié",
      "sourceRef": "https://www.scribd.com/document/1067004050/%E4%BA%BA%E6%95%99%E7%89%88-%E4%B8%89%E5%B9%B4%E7%BA%A7%E4%B8%8A%E5%86%8C-2025%E7%A7%8B%E7%89%88-%E8%AF%AD%E6%96%87%E7%94%B5%E5%AD%90%E8%AF%BE%E6%9C%AC 印刷页14",
      "sourceKind": "public_domain_poem",
      "id": "cn-04-clip-38",
      "spokenText": "远上寒山石径斜，",
      "file": "audio/chinese-pilot/c62d0e4ba939647c970ef14a.mp3",
      "durationSeconds": 2.184,
      "bytes": 35372
    },
    "cn-04-clip-39": {
      "text": "白云生处有人家。",
      "pinyin": "bái yún shēng chù yǒu rén jiā",
      "sourceRef": "https://www.scribd.com/document/1067004050/%E4%BA%BA%E6%95%99%E7%89%88-%E4%B8%89%E5%B9%B4%E7%BA%A7%E4%B8%8A%E5%86%8C-2025%E7%A7%8B%E7%89%88-%E8%AF%AD%E6%96%87%E7%94%B5%E5%AD%90%E8%AF%BE%E6%9C%AC 印刷页14",
      "sourceKind": "public_domain_poem",
      "id": "cn-04-clip-39",
      "spokenText": "白云生处有人家。",
      "file": "audio/chinese-pilot/14fdee472c3be5a8093d4016.mp3",
      "durationSeconds": 1.992,
      "bytes": 32300
    },
    "cn-04-clip-40": {
      "text": "停车坐爱枫林晚，",
      "pinyin": "tíng chē zuò ài fēng lín wǎn",
      "sourceRef": "https://www.scribd.com/document/1067004050/%E4%BA%BA%E6%95%99%E7%89%88-%E4%B8%89%E5%B9%B4%E7%BA%A7%E4%B8%8A%E5%86%8C-2025%E7%A7%8B%E7%89%88-%E8%AF%AD%E6%96%87%E7%94%B5%E5%AD%90%E8%AF%BE%E6%9C%AC 印刷页14",
      "sourceKind": "public_domain_poem",
      "id": "cn-04-clip-40",
      "spokenText": "停车坐爱枫林晚，",
      "file": "audio/chinese-pilot/655b051795118a26327497d2.mp3",
      "durationSeconds": 2.136,
      "bytes": 34604
    },
    "cn-04-clip-41": {
      "text": "霜叶红于二月花。",
      "pinyin": "shuāng yè hóng yú èr yuè huā",
      "sourceRef": "https://www.scribd.com/document/1067004050/%E4%BA%BA%E6%95%99%E7%89%88-%E4%B8%89%E5%B9%B4%E7%BA%A7%E4%B8%8A%E5%86%8C-2025%E7%A7%8B%E7%89%88-%E8%AF%AD%E6%96%87%E7%94%B5%E5%AD%90%E8%AF%BE%E6%9C%AC 印刷页14",
      "sourceKind": "public_domain_poem",
      "id": "cn-04-clip-41",
      "spokenText": "霜叶红于二月花。",
      "file": "audio/chinese-pilot/bfe6e116fc51bb7f85a43eb9.mp3",
      "durationSeconds": 2.088,
      "bytes": 33836
    },
    "cn-04-clip-42": {
      "text": "萧萧梧叶送寒声，",
      "pinyin": "xiāo xiāo wú yè sòng hán shēng",
      "sourceRef": "https://www.scribd.com/document/1067004050/%E4%BA%BA%E6%95%99%E7%89%88-%E4%B8%89%E5%B9%B4%E7%BA%A7%E4%B8%8A%E5%86%8C-2025%E7%A7%8B%E7%89%88-%E8%AF%AD%E6%96%87%E7%94%B5%E5%AD%90%E8%AF%BE%E6%9C%AC 印刷页15",
      "sourceKind": "public_domain_poem",
      "id": "cn-04-clip-42",
      "spokenText": "萧萧梧叶送寒声，",
      "file": "audio/chinese-pilot/3e90fb8588933b630535235e.mp3",
      "durationSeconds": 2.112,
      "bytes": 34220
    },
    "cn-04-clip-43": {
      "text": "江上秋风动客情。",
      "pinyin": "jiāng shàng qiū fēng dòng kè qíng",
      "sourceRef": "https://www.scribd.com/document/1067004050/%E4%BA%BA%E6%95%99%E7%89%88-%E4%B8%89%E5%B9%B4%E7%BA%A7%E4%B8%8A%E5%86%8C-2025%E7%A7%8B%E7%89%88-%E8%AF%AD%E6%96%87%E7%94%B5%E5%AD%90%E8%AF%BE%E6%9C%AC 印刷页15",
      "sourceKind": "public_domain_poem",
      "id": "cn-04-clip-43",
      "spokenText": "江上秋风动客情。",
      "file": "audio/chinese-pilot/fb729bdfd23357c43bcb09f1.mp3",
      "durationSeconds": 2.16,
      "bytes": 34988
    },
    "cn-04-clip-44": {
      "text": "知有儿童挑促织，",
      "pinyin": "zhī yǒu ér tóng tiǎo cù zhī",
      "sourceRef": "https://www.scribd.com/document/1067004050/%E4%BA%BA%E6%95%99%E7%89%88-%E4%B8%89%E5%B9%B4%E7%BA%A7%E4%B8%8A%E5%86%8C-2025%E7%A7%8B%E7%89%88-%E8%AF%AD%E6%96%87%E7%94%B5%E5%AD%90%E8%AF%BE%E6%9C%AC 印刷页15",
      "sourceKind": "public_domain_poem",
      "id": "cn-04-clip-44",
      "spokenText": "知有儿童挑促织，",
      "file": "audio/chinese-pilot/dd0eee3f44b33071f2d67762.mp3",
      "durationSeconds": 1.968,
      "bytes": 31916
    },
    "cn-04-clip-45": {
      "text": "夜深篱落一灯明。",
